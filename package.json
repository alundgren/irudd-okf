{
  "name": "irudd-okf",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "build": "node scripts/licenses.mjs && vp pack",
    "install:cli": "vp run build && node scripts/install-cli.mjs",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "okf": "node --import tsx packages/cli/src/main.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "effect": "4.0.0",
    "markdown-it": "14.3.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.0.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  }
}
